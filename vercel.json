{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/baseball",
      "destination": "/games/baseball"
    },
    {
      "source": "/fieldgoal",
      "destination": "/games/fieldgoal"
    },
    {
      "source": "/pk",
      "destination": "/games/pk"
    },
    {
      "source": "/hockey",
      "destination": "/games/hockey"
    },
    {
      "source": "/golf",
      "destination": "/games/golf"
    },
    {
      "source": "/drag",
      "destination": "/games/drag"
    }
  ],
  "redirects": [
    {
      "source": "/field-goal",
      "destination": "/fieldgoal",
      "permanent": true
    },
    {
      "source": "/penalty",
      "destination": "/pk",
      "permanent": true
    }
  ]
}
